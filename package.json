{
  "name": "pi-tweaks-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for personal Pi tweaks.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-tweaks"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/src/index.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run config:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "test": "vitest run --maxWorkers=8",
    "test:package": "npm run build && node scripts/package-check.mjs",
    "typecheck": "tsc --noEmit",
    "release": "release --root .",
    "release:dry-run": "release --dry --root .",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check",
    "prepack": "npm run config:check && npm run build"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.5.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-rules": "^0.2.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/src/index.ts"
    ]
  }
}
